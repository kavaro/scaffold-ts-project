{
  "name": "scaffold-ts-project",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "benchmark": "vitest bench --reporter=verbose --run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "sideEffects": false
}